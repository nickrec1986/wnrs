---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from './LogoMarquee.astro';
import TestimonialBlock from './TestimonialBlock.astro';
import ContactSection from './ContactSection.astro';
import { withBase, pageHero } from '../base';
import { productionAssetUrl } from '../seo';
import { localeFromPath, localeHref, LOCALE_META } from '../i18n/locale';
import { ui } from '../i18n/ui';
import { localizedHome, localizedSeo, localizedServices, localizedSite, localizedVertical } from '../i18n/content';
import type { Vertical } from '../consts';

interface Props { vertical: Vertical }
const { vertical: incoming } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const href = (path: string) => withBase(localeHref(path, locale));
const vertical = localizedVertical(incoming.slug, locale) ?? incoming;
const kindLabel = vertical.kind === 'sector' ? t.sector : t.industryKind;
const seo = localizedSeo(`/${vertical.slug}`, locale);
const site = localizedSite(locale);
const services = localizedServices(locale);
const home = localizedHome(locale);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${vertical.name} accounts receivable management — ${site.name}`,
  serviceType: `Accounts receivable management for ${vertical.name}`,
  description: seo.description,
  url: `${LOCALE_META[locale].origin}/${vertical.slug}/`,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  audience: vertical.audience,
  areaServed: ['US', 'CA', 'MX', 'BR', 'LATAM'],
};
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={LOCALE_META[locale].htmlLang}
  ogImage={productionAssetUrl(`/heroes/${vertical.slug}.jpg`)}
  breadcrumbs={[
    { name: t.services, path: '/services' },
    { name: vertical.name, path: `/${vertical.slug}` },
  ]}
  jsonLd={jsonLd}
>
  <header class="page-hero">
    <div class="wrap page-split">
      <div>
        <p class="kicker">{kindLabel}</p>
        <h1>{vertical.name}</h1>
        <p class="lede">{vertical.intro}</p>
        <a class="btn" href={href('/#contact')}>{t.talkToExpert}</a>
      </div>
      <img class="hero-photo" src={pageHero(vertical.slug)} alt={t.collectionsAlt(vertical.name)} />
    </div>
  </header>

  <section class="sec">
    <div class="wrap page-split" style="align-items:start">
      <div class="prose-el">
        <h2>{t.collectionServicesFor(vertical.name)}</h2>
        <p>{vertical.overview}</p>
        <p>{t.pickTheStage}</p>
      </div>
      <aside class="stats-card">
        <h3>{t.whatYouCanExpect}</h3>
        <ul class="list-checks" style="margin-top:12px">
          {vertical.benefits.map((b) => (
            <li><span class="check">✓</span><span>{b}</span></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2>{t.collectionServices}</h2>
      <div class="svc-grid">
        {services.map((s) => (
          <a class="svc-tile" href={href(`/${s.slug}`)}>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LogoMarquee label={home.logosLabel} />
  <TestimonialBlock />
  <ContactSection />
</BaseLayout>
