---
import { withBase } from '../base';
import { localeFromPath } from '../i18n/locale';
import { ui } from '../i18n/ui';
import { localizedHome, localizedTestimonials } from '../i18n/content';

const locale = localeFromPath(Astro.url.pathname);
const home = localizedHome(locale);
const t = ui(locale);
const quote = localizedTestimonials(locale)[0];
---
<section class="quotes-el">
  <div class="wrap">
    <div class="quotes-head">
      <div>
        <h2>{t.whatClientsSay}</h2>
        <p class="sub" style="max-width:48ch">
          {home.quotesSub}
        </p>
      </div>
      <div class="qnav" aria-hidden="true">
        <button type="button">‹</button>
        <button type="button">›</button>
      </div>
    </div>
    <blockquote class="quote-card">
      <div class="stars">★★★★★</div>
      <p>"{quote.quote}"</p>
      <div class="who">
        <img src={withBase('/brand/juan-romero.jpg')} alt={quote.name} width="52" height="52" />
        <div>
          <b>{quote.name}</b>
          <span>{quote.title} {quote.company}</span>
        </div>
      </div>
    </blockquote>
  </div>
</section>
