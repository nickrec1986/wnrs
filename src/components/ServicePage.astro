---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialBlock from './TestimonialBlock.astro';
import ContactSection from './ContactSection.astro';
import { withBase, pageHero } from '../base';
import { productionAssetUrl } from '../seo';
import { localeFromPath, localeHref, LOCALE_META } from '../i18n/locale';
import { ui } from '../i18n/ui';
import { localizedService, localizedSeo, localizedSite } from '../i18n/content';

interface Props { slug: string }
const { slug } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const href = (path: string) => withBase(localeHref(path, locale));
const svc = localizedService(slug, locale);
if (!svc) throw new Error(`Unknown service slug: ${slug}`);
const seo = localizedSeo(`/${slug}`, locale);
const site = localizedSite(locale);
// ES/PT follow live .mx: blue eyebrow = service name, black H1 = distinct tagline.
// EN keeps the existing hero (brand kicker + service-name H1).
const useTaglineHero =
  locale !== 'en' && Boolean(svc.tagline) && svc.tagline !== svc.navLabel && svc.tagline !== svc.name;
const eyebrow = useTaglineHero ? svc.navLabel : t.debtCollectionExperts;
const heading = useTaglineHero ? svc.tagline : svc.navLabel;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${svc.name} — ${site.name}`,
  serviceType: svc.name,
  description: seo.description,
  url: `${LOCALE_META[locale].origin}/${slug}/`,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: ['US', 'CA', 'MX', 'BR', 'LATAM'],
};
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  lang={LOCALE_META[locale].htmlLang}
  ogImage={productionAssetUrl(`/heroes/${slug}.jpg`)}
  breadcrumbs={[
    { name: t.services, path: '/services' },
    { name: svc.navLabel, path: `/${slug}` },
  ]}
  jsonLd={jsonLd}
>
  <header class="page-hero">
    <div class="wrap page-split">
      <div>
        <p class="kicker">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="lede">{svc.intro}</p>
        <a class="btn" href={href('/#contact')}>{t.talkToExpert}</a>
      </div>
      <img class="hero-photo" src={pageHero(slug)} alt={t.serviceHeroAlt(svc.navLabel)} />
    </div>
  </header>

  <section class="sec" style="padding-top:1.5rem">
    <div class="wrap">
      <div class="tabs" role="tablist">
        <button class="on" type="button" data-tab="overview">{t.overview}</button>
        <button type="button" data-tab="benefits">{t.benefits}</button>
      </div>
      <div class="tab-panel">
        <div class="page-split" style="align-items:start">
          <div class="prose-el">
          <div id="panel-overview">
            <p class="kicker" style="display:flex;align-items:center;gap:8px"><span class="check">✓</span> {t.overview}</p>
            <h2>{t.overview}</h2>
            {svc.overview.map((p) => <p>{p}</p>)}
          </div>
          <div id="panel-benefits" hidden>
            <h2>{t.benefits}</h2>
            <ul class="list-arrows">
              {svc.benefits.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        </div>
        <div class="dash-art">
          <img
            id="aside-art"
            src={withBase('/brand/results-analysis.png')}
            data-overview={withBase('/brand/results-analysis.png')}
            data-benefits={withBase('/brand/demand-gen.png')}
            data-overview-alt={t.campaignResultsAlt}
            data-benefits-alt={t.outreachAlt}
            alt={t.campaignResultsAlt}
          />
        </div>
        </div>
      </div>
    </div>
  </section>

  <TestimonialBlock />
  <ContactSection />
</BaseLayout>
<script>
  const buttons = document.querySelectorAll('[data-tab]');
  const overview = document.getElementById('panel-overview');
  const benefits = document.getElementById('panel-benefits');
  const art = document.getElementById('aside-art');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      const tab = btn.getAttribute('data-tab');
      if (overview && benefits) {
        overview.hidden = tab !== 'overview';
        benefits.hidden = tab !== 'benefits';
      }
      if (art) {
        const next = tab === 'benefits' ? art.dataset.benefits : art.dataset.overview;
        if (next) art.src = next;
        art.alt = tab === 'benefits' ? (art.dataset.benefitsAlt || art.alt) : (art.dataset.overviewAlt || art.alt);
      }
    });
  });
</script>
