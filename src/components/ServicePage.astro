---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from './LogoMarquee.astro';
import TestimonialBlock from './TestimonialBlock.astro';
import ContactSection from './ContactSection.astro';
import { SERVICES, getService, SITE } from '../consts';

interface Props { slug: string }
const { slug } = Astro.props;
const svc = getService(slug);
if (!svc) throw new Error(`Unknown service slug: ${slug}`);
const others = SERVICES.filter((s) => s.slug !== slug);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${svc.name} — ${SITE.name}`,
  serviceType: svc.name,
  description: svc.intro,
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  areaServed: ['US', 'CA', 'MX', 'BR', 'LATAM'],
};
---
<BaseLayout title={`${svc.name} | ${SITE.name}`} description={svc.intro} jsonLd={jsonLd}>
  <header class="page-hero">
    <div class="wrap page-split">
      <div>
        <p class="kicker">Debt Collection Experts</p>
        <h1>{svc.navLabel}</h1>
        <p class="lede">{svc.intro}</p>
        <a class="btn" href="/#contact">Get a quote</a>
      </div>
      <img src="/brand/hero.jpg" alt="" />
    </div>
  </header>

  <section class="sec" style="padding-top:1.5rem">
    <div class="wrap">
      <div class="tabs" role="tablist">
        <button class="on" type="button" data-tab="overview">Overview</button>
        <button type="button" data-tab="benefits">Benefits</button>
      </div>
      <div class="page-split" style="align-items:start">
        <div class="prose-el">
          <div id="panel-overview">
            <p class="kicker" style="display:flex;align-items:center;gap:8px"><span class="check">✓</span> Overview</p>
            <h2>Overview</h2>
            {svc.overview.map((p) => <p>{p}</p>)}
            <h2>What’s included</h2>
            <ul class="list-checks">
              {svc.included.map((item) => (
                <li><span class="check">✓</span><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div id="panel-benefits" hidden>
            <p class="kicker" style="display:flex;align-items:center;gap:8px"><span class="check">✓</span> Benefits</p>
            <h2>Benefits</h2>
            <ul class="list-checks">
              {svc.benefits.map((b) => (
                <li><span class="check">✓</span><span>{b}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <aside class="stats-card">
          <img class="photo" src="/brand/hero.jpg" alt="" style="height:180px" />
          <h3>Everything you need</h3>
          <p class="prose-el">Pick a related service or talk to us about a custom ARM program.</p>
        </aside>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="sec" style="padding-top:0">
      <div class="wrap">
        <h2>Related services</h2>
        <div class="svc-grid">
          {others.map((s) => (
            <a class="svc-tile" href={`/${s.slug}`}>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <LogoMarquee />
  <TestimonialBlock />
  <ContactSection />
</BaseLayout>
<script>
  const buttons = document.querySelectorAll('[data-tab]');
  const overview = document.getElementById('panel-overview');
  const benefits = document.getElementById('panel-benefits');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      const tab = btn.getAttribute('data-tab');
      if (overview && benefits) {
        overview.hidden = tab !== 'overview';
        benefits.hidden = tab !== 'benefits';
      }
    });
  });
</script>
