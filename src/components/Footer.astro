---
import { SERVICES, FEATURED_INDUSTRIES, EMAIL, EMAIL_HREF, PHONE_DISPLAY, PHONE_HREF, SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap fgrid">
    <div class="fbrand">
      <a class="brand-logo" href="/" aria-label="WNRS home">
        <img src="/brand/logo-wnrs.png" alt="WNRS" width="160" height="46" />
      </a>
      <div class="social" aria-label="Social">
        <a href="https://www.linkedin.com/company/wnrs" aria-label="LinkedIn">in</a>
        <a class="x" href="https://x.com" aria-label="X">X</a>
        <a href="https://www.instagram.com" aria-label="Instagram">ig</a>
        <a href="https://www.facebook.com" aria-label="Facebook">f</a>
      </div>
    </div>
    <div class="fcol">
      <div class="fh">Types</div>
      {SERVICES.map((s) => (
        <a href={`/${s.slug}`}>{s.navLabel}</a>
      ))}
    </div>
    <div class="fcol">
      <div class="fh">Industry</div>
      {FEATURED_INDUSTRIES.map((i) => (
        <a href={`/${i.slug}`}>{i.name}</a>
      ))}
      <a href="/services#industries">More…</a>
    </div>
    <div class="fcol">
      <div class="fh">Resources</div>
      <a href={EMAIL_HREF}>{EMAIL}</a>
      <a href={PHONE_HREF}>{PHONE_DISPLAY}</a>
    </div>
  </div>
  <div class="wrap legal">
    <div>Copyright © {year} {SITE.name}</div>
    <div>
      <a href="/terms">Terms of service</a>
      {' · '}
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>
