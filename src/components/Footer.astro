---
import { SERVICES, FEATURED_INDUSTRIES, EMAIL, EMAIL_HREF, PHONE_DISPLAY, PHONE_HREF, SITE } from '../consts';
import { withBase } from '../base';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap fgrid">
    <div class="fbrand">
      <a class="brand-logo" href={withBase('/')} aria-label="WNRS home">
        <img src={withBase('/brand/logo-wnrs.png')} alt="WNRS — Accelerate your Cashflow" width="160" height="46" />
      </a>
      <div class="social" aria-label="Social">
        <a class="li" href="https://www.linkedin.com/company/wnrscollections" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.5h4.52V24H.24V8.5zM8.34 8.5h4.33v2.12h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-7.7c0-1.84-.03-4.2-2.56-4.2-2.56 0-2.95 2-2.95 4.06V24H8.34V8.5z"/></svg>
        </a>
      </div>
    </div>
    <div class="fcol">
      <div class="fh">Types</div>
      {SERVICES.map((s) => (
        <a href={withBase(`/${s.slug}`)}>{s.navLabel}</a>
      ))}
    </div>
    <div class="fcol">
      <div class="fh">Industry</div>
      {FEATURED_INDUSTRIES.map((i) => (
        <a href={withBase(`/${i.slug}`)}>{i.name}</a>
      ))}
      <a href={withBase('/services#industries')}>More…</a>
    </div>
    <div class="fcol">
      <div class="fh">Resources</div>
      <a href={withBase('/insights')}>Insights</a>
      <a href={EMAIL_HREF}>{EMAIL}</a>
      <a href={PHONE_HREF}>{PHONE_DISPLAY}</a>
    </div>
  </div>
  <div class="wrap legal">
    <div>Copyright © {year} {SITE.name}</div>
    <div>
      <a href={withBase('/terms')}>Terms of service</a>
      <a href={withBase('/privacy')} style="margin-left:18px">Privacy policy</a>
    </div>
  </div>
</footer>
