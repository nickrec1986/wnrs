---
import IndustryPage from '../IndustryPage.astro';
import ServicePage from '../ServicePage.astro';
import { getService, getVertical } from '../../consts';
import HomeView from './HomeView.astro';
import AboutView from './AboutView.astro';
import ServicesHubView from './ServicesHubView.astro';
import InsightsView from './InsightsView.astro';
import PrivacyView from './PrivacyView.astro';
import TermsView from './TermsView.astro';
import NotFoundView from './NotFoundView.astro';

interface Props {
  path?: string;
}
const raw = Astro.props.path ?? '';
const path = raw.replace(/^\/+|\/+$/g, '');
---
{!path ? (
  <HomeView />
) : path === 'about-us' ? (
  <AboutView />
) : path === 'services' ? (
  <ServicesHubView />
) : path === 'insights' ? (
  <InsightsView />
) : path === 'privacy' ? (
  <PrivacyView />
) : path === 'terms' ? (
  <TermsView />
) : path === '404' ? (
  <NotFoundView />
) : getService(path) ? (
  <ServicePage slug={path} />
) : getVertical(path) ? (
  <IndustryPage vertical={getVertical(path)!} />
) : (
  <NotFoundView />
)}
