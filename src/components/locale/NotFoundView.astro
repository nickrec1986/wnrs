---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../base';
import { localeFromPath, localeHref, LOCALE_META } from '../../i18n/locale';
import { ui } from '../../i18n/ui';
import { localizedSeo } from '../../i18n/content';

const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const seo = localizedSeo('/404', locale);
const href = (path: string) => withBase(localeHref(path, locale));
---
<BaseLayout title={seo.title} description={seo.description} lang={LOCALE_META[locale].htmlLang} noindex>
  <section class="hero-el">
    <div class="inner">
      <p class="kicker">404</p>
      <h1>{t.notFoundH1}</h1>
      <p class="lede">{t.notFoundLede}</p>
      <a class="btn" href={href('/')}>{t.home}</a>
    </div>
  </section>
</BaseLayout>
