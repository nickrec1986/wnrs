---
import { SERVICES, FEATURED_INDUSTRIES, PHONE, PHONE_HREF, PORTAL_URL, LOCALES } from '../consts';
---
<nav class="site" id="nav">
  <div class="bar">
    <a href="/" class="logo" aria-label="WNRS home">
      <span class="mark" aria-hidden="true">W</span>
      WNRS
    </a>

    <div class="links" id="nav-links">
      <div class="drop">
        <button class="drop-toggle" type="button" aria-haspopup="true">Services</button>
        <div class="drop-menu" role="menu">
          {SERVICES.map((s) => (
            <a href={`/${s.slug}`} role="menuitem">{s.navLabel}</a>
          ))}
          <a class="more" href="/services" role="menuitem">All services →</a>
        </div>
      </div>
      <div class="drop">
        <button class="drop-toggle" type="button" aria-haspopup="true">Industries</button>
        <div class="drop-menu" role="menu">
          {FEATURED_INDUSTRIES.map((i) => (
            <a href={`/${i.slug}`} role="menuitem">{i.name}</a>
          ))}
          <a class="more" href="/services#industries" role="menuitem">More industries →</a>
        </div>
      </div>
      <a href="/about-us">About Us</a>
      <a href={PORTAL_URL}>Login</a>
      <a class="nl-phone" href={PHONE_HREF}>{PHONE}</a>
    </div>

    <div class="nav-cta">
      <div class="locales" aria-label="Language">
        {LOCALES.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={l.href} class={l.code === 'en' ? 'on' : undefined} hreflang={l.code === 'pt' ? 'pt-BR' : l.code}>
              {l.label}
            </a>
          </>
        ))}
      </div>
      <a href="/#contact" class="btn btn-gold">Book a call</a>
      <button class="hamburger" type="button" aria-label="Open menu" aria-controls="nav-links" id="nav-toggle">
        <span></span>
      </button>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  const toggle = document.getElementById('nav-toggle');
  toggle?.addEventListener('click', () => nav?.classList.toggle('open'));
  nav?.querySelectorAll('.drop-toggle').forEach((btn) => {
    btn.addEventListener('click', () => btn.parentElement?.classList.toggle('open'));
  });
</script>
