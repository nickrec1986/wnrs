---
import { SERVICES, FEATURED_INDUSTRIES, LOCALES, PORTAL_URL } from '../consts';
import { withBase } from '../base';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const servicesPath = withBase('/services').replace(/\/$/, '');
const servicesOn = path === servicesPath || SERVICES.some((s) => path.includes(s.slug));
---
<header class="site-header" id="nav">
  <div class="bar">
    <a class="brand-logo" href={withBase('/')} aria-label="WNRS home">
      <img src={withBase('/brand/logo-wnrs.png')} alt="WNRS — Accelerate your Cashflow" width="180" height="52" />
    </a>

    <nav class="nav-main" id="nav-links">
      <div class="nav-drop">
        <button type="button" class:list={['drop-toggle', { on: servicesOn }]}>Services <span class="caret">▾</span></button>
        <div class="mega" role="menu">
          <div>
            <div class="mh">Types</div>
            {SERVICES.map((s) => (
              <a href={withBase(`/${s.slug}`)}>{s.navLabel}</a>
            ))}
            <a href={withBase('/services')}>All services</a>
          </div>
          <div>
            <div class="mh">Industry</div>
            {FEATURED_INDUSTRIES.map((i) => (
              <a href={withBase(`/${i.slug}`)}>{i.name}</a>
            ))}
            <a href={withBase('/services#industries')}>More…</a>
          </div>
        </div>
      </div>
      <a href={withBase('/about-us')}>About Us</a>
      <div class="mobile-only locale-row">
        {LOCALES.map((l) => (
          <a href={l.href} hreflang={l.code === 'pt' ? 'pt-BR' : l.code}>{l.label}</a>
        ))}
      </div>
      <a class="mobile-only" href={PORTAL_URL}>Login</a>
      <a class="mobile-only btn" href={withBase('/#contact')}>Book a Call</a>
    </nav>

    <div class="nav-end">
      <div class="nav-drop">
        <button type="button" class="drop-toggle">EN <span class="caret">▾</span></button>
        <div class="lang-menu">
          {LOCALES.map((l) => (
            <a href={l.href} hreflang={l.code === 'pt' ? 'pt-BR' : l.code}>{l.label}</a>
          ))}
        </div>
      </div>
      <a class="plain" href={PORTAL_URL}>Login</a>
      <a class="btn" href={withBase('/#contact')}>Book a Call</a>
      <button class="hamburger" type="button" id="nav-toggle" aria-label="Open menu" aria-controls="nav-links">
        <span></span>
      </button>
    </div>
  </div>
</header>
<script>
  const nav = document.getElementById('nav');
  document.getElementById('nav-toggle')?.addEventListener('click', () => nav?.classList.toggle('open'));
  nav?.querySelectorAll('.drop-toggle').forEach((btn) => {
    btn.addEventListener('click', () => btn.parentElement?.classList.toggle('open'));
  });
</script>
