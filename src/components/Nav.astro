---
import { SERVICES, FEATURED_INDUSTRIES, LOCALES, PORTAL_URL } from '../consts';
---
<header class="site-header" id="nav">
  <div class="bar">
    <a class="brand-logo" href="/" aria-label="WNRS home">
      <img src="/brand/logo-wnrs.png" alt="WNRS — Accelerate your Cashflow" width="180" height="52" />
    </a>

    <nav class="nav-main" id="nav-links">
      <div class="nav-drop">
        <button type="button" class="drop-toggle">Services <span class="caret">▾</span></button>
        <div class="mega" role="menu">
          <div>
            <div class="mh">Types</div>
            {SERVICES.map((s) => (
              <a href={`/${s.slug}`}>{s.navLabel}</a>
            ))}
            <a href="/services">All services</a>
          </div>
          <div>
            <div class="mh">Industry</div>
            {FEATURED_INDUSTRIES.map((i) => (
              <a href={`/${i.slug}`}>{i.name}</a>
            ))}
            <a href="/services#industries">More…</a>
          </div>
        </div>
      </div>
      <div class="nav-drop">
        <button type="button" class="drop-toggle">Industry <span class="caret">▾</span></button>
        <div class="mega mega-single" role="menu">
          <div>
            {FEATURED_INDUSTRIES.map((i) => (
              <a href={`/${i.slug}`}>{i.name}</a>
            ))}
            <a href="/services#industries">More…</a>
          </div>
        </div>
      </div>
      <a href="/about-us">About Us</a>
    </nav>

    <div class="nav-end">
      <div class="nav-drop">
        <button type="button" class="drop-toggle">EN <span class="caret">▾</span></button>
        <div class="lang-menu">
          {LOCALES.map((l) => (
            <a href={l.href} hreflang={l.code === 'pt' ? 'pt-BR' : l.code}>{l.label}</a>
          ))}
        </div>
      </div>
      <a class="plain" href={PORTAL_URL}>Login</a>
      <a class="btn" href="/#contact">Book a Call</a>
      <button class="hamburger" type="button" id="nav-toggle" aria-label="Open menu" aria-controls="nav-links">
        <span></span>
      </button>
    </div>
  </div>
</header>
<script>
  const nav = document.getElementById('nav');
  document.getElementById('nav-toggle')?.addEventListener('click', () => nav?.classList.toggle('open'));
  nav?.querySelectorAll('.drop-toggle').forEach((btn) => {
    btn.addEventListener('click', () => btn.parentElement?.classList.toggle('open'));
  });
</script>
