---
import { SITE, PHONE, EMAIL, LOCALES } from '../consts';
import { withBase } from '../base';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD object(s) to inject (Service, FAQPage, etc.) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Override OG type (default website) */
  ogType?: string;
  /** HTML lang attribute */
  lang?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  jsonLd,
  ogType = 'website',
  lang = 'en',
} = Astro.props;

const origin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, origin).href.replace(/\/$/, '') || origin.href;
const ogImage = new URL(withBase('/og-default.jpg'), origin).href;
const favicon = withBase('/brand/favicon.png');
const sitemapHref = withBase('/sitemap-index.xml');
const assetMotif = withBase('/brand/bg-motif.svg');
const assetArrow = withBase('/icons/right.svg');

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  description: SITE.description,
  slogan: SITE.slogan,
  email: EMAIL,
  telephone: PHONE,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Miami',
    addressRegion: 'FL',
    addressCountry: 'US',
  },
  sameAs: [] as string[],
};

const ldBlocks = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!DOCTYPE html>
<html lang={lang} style={`--asset-motif: url(${assetMotif}); --asset-arrow: url(${assetArrow});`}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={favicon} type="image/png" />

  {LOCALES.map((l) => (
    <link rel="alternate" hreflang={l.code === 'pt' ? 'pt-BR' : l.code} href={l.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={SITE.url} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="sitemap" href={sitemapHref} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  {ldBlocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</head>
<body>
  <Nav />
  <slot />
  <Footer />

  <script>
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => obs.observe(el));
  </script>
</body>
</html>
