---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EMAIL, EMAIL_HREF, PHONE, PHONE_HREF } from '../../consts';
---
<BaseLayout
  lang="pt-BR"
  title={`WNRS Brasil | Cobrança e gestão de recebíveis`}
  description="WNRS — especialistas em cobrança e gestão de contas a receber. Site em português em construção. Fale conosco."
>
  <section class="hero">
    <div class="inner wrap">
      <div class="kicker">wnrs.com.br · pt-BR</div>
      <h1 class="disp">Seus recebíveis.<br /><span class="l2">Recuperados.</span><br /><span class="l3">Rápido.</span></h1>
      <p class="lede">
        A versão em português do site WNRS está em montagem neste codebase (pastas <code>/pt</code>).
        Enquanto isso, fale com a equipe ou use o site em inglês.
      </p>
      <div class="hero-cta">
        <a class="btn btn-gold" href={EMAIL_HREF}>{EMAIL}</a>
        <a class="btn btn-ghost" href={PHONE_HREF}>{PHONE}</a>
        <a class="btn btn-ghost" href="/">English site →</a>
      </div>
    </div>
  </section>
</BaseLayout>
