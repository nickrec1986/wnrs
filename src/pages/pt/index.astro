---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { EMAIL, EMAIL_HREF, PHONE, PHONE_HREF } from '../../consts';
import { withBase } from '../../base';
---
<BaseLayout
  lang="pt-BR"
  title={`WNRS Brasil | Cobrança e gestão de recebíveis`}
  description="WNRS — especialistas em cobrança e gestão de contas a receber. Site em português em construção. Fale conosco."
>
  <section class="hero-el">
    <div class="inner">
      <p class="kicker">wnrs.com.br · pt-BR</p>
      <h1>Seus recebíveis.<br />Recuperados. Rápido.</h1>
      <p class="lede">
        A versão em português do site WNRS está em montagem neste codebase (rotas <code>/pt</code>).
        Enquanto isso, fale com a equipe ou use o site em inglês.
      </p>
      <a class="btn btn-lg" href={EMAIL_HREF}>{EMAIL}</a>
      <p style="margin-top:16px"><a href={withBase('/')}>English site →</a> · <a href={PHONE_HREF}>{PHONE}</a></p>
    </div>
  </section>
</BaseLayout>
