---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import TestimonialBlock from '../../components/TestimonialBlock.astro';
import ContactSection from '../../components/ContactSection.astro';
import { SERVICES, SECTORS, INDUSTRIES, SITE } from '../../consts';
---
<BaseLayout
  title={`Services | ${SITE.name}`}
  description="Explore WNRS accounts receivable and collection services by type, industry, or sector."
>
  <header class="page-hero">
    <div class="wrap center">
      <p class="kicker">Explore</p>
      <h1>WNRS Services</h1>
      <p class="lede" style="margin-left:auto;margin-right:auto">
        Sophisticated accounts receivable and collection services don’t have to be complicated.
        At WNRS we believe in keeping it simple – and smart. Results are what make us the market leader in collections.
        Explore our services by type, industry, or sector.
      </p>
      <a class="btn" href="/#contact">Get a quote</a>
    </div>
  </header>

  <LogoMarquee />

  <section class="sec" id="sectors">
    <div class="wrap center">
      <h2>Services by Sector</h2>
      <p class="sub">Have an existing ARM need? From business to enterprise, to government services, we have what you need to collect.</p>
    </div>
    <div class="wrap svc-grid">
      {SECTORS.map((s) => (
        <a class="svc-tile" href={`/${s.slug}`}>
          <h3>{s.name}</h3>
          <p>{s.short}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="sec" id="types" style="padding-top:0">
    <div class="wrap center">
      <h2>Services by Type</h2>
      <p class="sub">
        Looking for ways to help your Accounts Receivable run better? Choose amongst our award-winning
        accounts receivable management services.
      </p>
    </div>
    <div class="wrap svc-grid">
      {SERVICES.map((s) => (
        <a class="svc-tile" href={`/${s.slug}`}>
          <h3>{s.name}</h3>
          <p>{s.short}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="sec" id="industries" style="padding-top:0">
    <div class="wrap center">
      <h2>Services by Industry</h2>
      <p class="sub">What differentiates world-class ARM is often industry-specific process. Leverage ours.</p>
    </div>
    <div class="wrap svc-grid">
      {INDUSTRIES.map((i) => (
        <a class="svc-tile" href={`/${i.slug}`}>
          <h3>{i.name}</h3>
          <p>{i.short}</p>
        </a>
      ))}
    </div>
  </section>

  <TestimonialBlock />
  <ContactSection />
</BaseLayout>
