---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ContactSection from '../components/ContactSection.astro';
import { ABOUT, SITE, SERVICES, PRESS_LOGOS } from '../consts';
import { withBase } from '../base';
---
<BaseLayout
  title={`About Us | ${SITE.name}`}
  description="WNRS is a leading global provider of customized debt collection and accounts receivable management, headquartered in Miami with operations across the Americas."
>
  <header class="page-hero">
    <div class="wrap center">
      <p class="kicker">About WNRS</p>
      <h1>About WNRS</h1>
      <p class="lede" style="margin-left:auto;margin-right:auto">{ABOUT.lede}</p>
      <a class="btn" href={withBase('/#contact')}>Get a quote</a>
    </div>
  </header>

  <LogoMarquee label="Our Clients" />

  <section class="sec">
    <div class="wrap page-split">
      <div class="prose-el">
        <h2>Operation Centers</h2>
        {ABOUT.body.map((p) => <p>{p}</p>)}
        <a class="text-link" href={withBase('/#contact')}>Contact Us <span aria-hidden="true">→</span></a>
      </div>
      <figure>
        <img class="ceo-photo" src={withBase('/brand/david-fridman.jpg')} alt="David Fridman, CEO of WNRS" />
      </figure>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap prose-el" style="max-width:720px">
      <h2>Vision, Mission and Objective</h2>
      <p>{ABOUT.vision}</p>
      <p>{ABOUT.mission}</p>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2>Objectives</h2>
      <ul class="list-checks" style="margin-top:16px;max-width:720px">
        {ABOUT.objectives.map((o) => (
          <li><span class="check">✓</span><span>{o}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2>Features &amp; Benefits</h2>
      <div class="svc-grid" style="margin-top:22px">
        {ABOUT.features.map((f) => (
          <div class="svc-tile">
            <h3>{f.h}</h3>
            <p>{f.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap recognized-split">
      <h2>Recognized by:</h2>
      <div class="press-grid">
        {PRESS_LOGOS.map((l) => (
          <figure>
            <img src={l.src} alt={l.alt} />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <h2>Everything you need for any stage of the receivable experience. Pick your service.</h2>
      <div class="svc-grid">
        {SERVICES.map((s) => (
          <a class="svc-tile" href={withBase(`/${s.slug}`)}>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
