---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, EMAIL, EMAIL_HREF } from '../consts';
---
<BaseLayout title={`Privacy policy | ${SITE.name}`} description="Privacy policy for the WNRS marketing website.">
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker"><a href="/">Home</a> / Privacy</p>
      <h1>Privacy policy</h1>
      <p class="lede">How the public WNRS marketing site handles information.</p>
    </div>
  </header>
  <section class="sec">
    <div class="wrap prose-el">
      <p>
        This static marketing site does not run a CMS, user accounts, or a collections database.
        If you email or call us, we use the contact details you send to respond to your inquiry.
      </p>
      <p>
        Client-file data lives on the separate portal at online.wnrs.com, not on this site.
        We do not sell marketing-site visitor lists.
      </p>
      <p>Questions: <a href={EMAIL_HREF}>{EMAIL}</a>.</p>
    </div>
  </section>
</BaseLayout>
