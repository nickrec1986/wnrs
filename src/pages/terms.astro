---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL, EMAIL_HREF, getSeo } from '../consts';
import { withBase } from '../base';

const seo = getSeo('/terms');
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={[{ name: 'Terms of service', path: '/terms' }]}
>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker"><a href={withBase('/')}>Home</a> / Terms</p>
      <h1>Terms of service</h1>
      <p class="lede">These terms govern use of the public WNRS marketing website. They are not a collections engagement agreement.</p>
    </div>
  </header>
  <section class="sec">
    <div class="wrap prose-el">
      <p>
        The content on this site is for general information about WNRS accounts receivable and collection services.
        Nothing here is legal advice, a credit decision, or a commitment to take a specific file.
      </p>
      <p>
        Engagement for collection work is governed by a separate written agreement between WNRS and the client.
        Use of the client portal at online.wnrs.com is governed by that portal’s own terms.
      </p>
      <p>Questions: <a href={EMAIL_HREF}>{EMAIL}</a>.</p>
    </div>
  </section>
</BaseLayout>
